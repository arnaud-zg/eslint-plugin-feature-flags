{
  "name": "eslint-plugin-feature-flags",
  "version": "0.1.2",
  "description": "ESLint rules for feature flag hygiene: flags past their expiry date, flags missing from your config, and an autofix that removes a flag once it is settled.",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "feature-flags",
    "feature-toggles",
    "technical-debt"
  ],
  "homepage": "https://github.com/arnaud-zg/eslint-plugin-feature-flags/tree/main/packages/eslint-plugin-feature-flags#readme",
  "bugs": {
    "url": "https://github.com/arnaud-zg/eslint-plugin-feature-flags/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arnaud-zg/eslint-plugin-feature-flags.git",
    "directory": "packages/eslint-plugin-feature-flags"
  },
  "license": "MIT",
  "author": "Arnaud Zheng",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "git clean -xdf .cache dist node_modules",
    "format": "prettier --write . --ignore-path ../../.prettierignore --cache --cache-location .cache/.prettiercache",
    "lint": "eslint --cache --cache-location .cache/.eslintcache",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "test:mutate": "stryker run ../../stryker.config.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "prettier": "@arnaud-zg/configs/prettier",
  "dependencies": {
    "@typescript-eslint/utils": "^8.34.0"
  },
  "devDependencies": {
    "@arnaud-zg/configs": "catalog:",
    "@types/estree": "^1.0.11",
    "@types/json-schema": "^7.0.15",
    "@types/node": "catalog:",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "eslint": ">=8.0.0 <10.0.0"
  },
  "engines": {
    "node": "^20.0.0 || ^18.0.0"
  }
}
