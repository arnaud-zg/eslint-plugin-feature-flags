{
  "name": "eslint-plugin-feature-flags-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "changeset": "changeset",
    "clean": "pnpm -r run clean",
    "format": "prettier --write . --cache --cache-location .cache/.prettiercache",
    "format:check": "prettier --check . --cache --cache-location .cache/.prettiercache",
    "lint": "eslint . --cache --cache-location .cache/.eslintcache",
    "lint:fix": "eslint . --fix --cache --cache-location .cache/.eslintcache",
    "lint:md": "remark . --frail --quiet",
    "prepare": "lefthook install",
    "test": "pnpm -r run test",
    "test:mutate": "pnpm -r --workspace-concurrency=1 run test:mutate",
    "typecheck": "pnpm -r run typecheck",
    "verify": "pnpm typecheck && pnpm lint && pnpm lint:md && pnpm format:check && pnpm test && pnpm build"
  },
  "prettier": "@arnaud-zg/configs/prettier",
  "devDependencies": {
    "@arnaud-zg/configs": "catalog:",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@eslint/js": "catalog:",
    "@ianvs/prettier-plugin-sort-imports": "catalog:",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "lefthook": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-packagejson": "catalog:",
    "remark-cli": "catalog:",
    "remark-preset-lint-recommended": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10.10.0"
  }
}
